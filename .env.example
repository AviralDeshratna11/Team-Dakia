SOURCING_DB=./sourcing.db
# Mode is an explicit field on each API request, not an environment default.
# Live worker reads this from its environment; never exposed to the frontend.
# CRUSTDATA_API_KEY=
# Gemini is opt-in per request via llm_enabled. Keys belong only in worker environment.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
