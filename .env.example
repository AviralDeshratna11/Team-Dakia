SOURCING_DB=./sourcing.db
# Mode is an explicit field on each API request, not an environment default.
# Live worker reads this from its environment; never exposed to the frontend.
# CRUSTDATA_API_KEY=
# Gemini is opt-in per request via llm_enabled. Credentials stay outside the repo.
GEMINI_BACKEND=vertex
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative for a separate Gemini Developer API account:
# GEMINI_BACKEND=developer
# GEMINI_API_KEY=
